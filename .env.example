# Frontend origin for CORS (comma-separated allowed)
FRONTEND_ORIGINS=http://localhost:3000
APP_ENV=development
DEMO_SESSION_SECRET=replace-with-a-long-random-string

# Database — SQLite for local demo. Use PostgreSQL in production.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agentcart
DATABASE_URL=sqlite+pysqlite:///./agentcart.db

# AI (optional). If unset, AgentCart uses labelled rule-based demo mode.

# AI (optional; rule-based fallback if unconfigured)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=25


# PayPal Sandbox — never commit real secrets
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
# Documented demo conversion used only because typical Sandbox merchants settle in USD.
# Catalog prices remain INR. This is not a live FX feed.
PAYPAL_INR_PER_USD=83.00

# Public URLs used in PayPal return/cancel
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

# Optional GitHub link shown in the footer
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/agentcart
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
